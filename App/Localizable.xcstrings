{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and %@, %@ to %@." : {
      "comment" : "The Report screen's counts line, such as '142 entries and 38 doses, 11 August to 11 November.' %1$@ is the entries count, %2$@ the doses count, %3$@ the period's first day and %4$@ today, each a day and a month.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$@, %3$@ to %4$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ и %2$@, с %3$@ по %4$@."
          }
        }
      }
    },
    "%@ by week: %@, %@" : {
      "comment" : "What VoiceOver reads for one chart of the report PDF, such as 'Pain by week: 13 weeks, entries logged in 11 of them'. %1$@ is the symptom's name, %2$@ how many weeks the chart shows, %3$@ how many of those weeks hold an entry. Counts only, never a judgement such as low or high.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ by week: %2$@, %3$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ по неделям: %2$@, %3$@"
