    "Every day at %@" : {
      "comment" : "How a schedule that repeats daily reads, such as 'Every day at 08:00'. %@ holds one or more clock times, such as 09:00 or 9:00 AM and 9:00 PM, already formatted for the language.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день в %@"
          }
        }
      }
    },
    "Every %lld days at %@" : {
      "comment" : "How a schedule that repeats every few days reads, such as 'Every 3 days at 08:00'. %1$lld is the number of days, at least 2. %2$@ holds the clock times, already formatted for the language. Needs every plural form of the language.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Every %1$lld day at %2$@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Every %1$lld days at %2$@"
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Каждые %1$lld день в %2$@"
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Каждые %1$lld дня в %2$@"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Каждые %1$lld дней в %2$@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Каждые %1$lld дня в %2$@"
                }
              }
            }
          }
        }
      }
    },
    "Every week on %@ at %@" : {
      "comment" : "How a schedule that repeats weekly reads, such as 'Every week on Friday at 09:00'. The first %@ is the weekdays and the second the clock times. %@ holds one or more weekday names, such as Friday or Monday and Friday, as the language writes a weekday on its own. In Russian that is the nominative case, so write the sentence so a list of nominative weekdays reads correctly in it. %@ holds one or more clock times, such as 09:00 or 9:00 AM and 9:00 PM, already formatted for the language.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую неделю: %1$@, в %2$@"
          }
        }
      }
    },
    "Every %lld weeks on %@ at %@" : {
      "comment" : "How a schedule that repeats every few weeks reads, such as 'Every 2 weeks on Friday at 09:00'. %1$lld is the number of weeks, at least 2. %2$@ holds the weekdays and %3$@ the clock times, already formatted for the language. In Russian the weekdays are in the nominative case, so write the sentence so a list of nominative weekdays reads correctly in it. Needs every plural form of the language.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Every %1$lld week on %2$@ at %3$@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Every %1$lld weeks on %2$@ at %3$@"
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
